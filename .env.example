# FuelOps platform environment template.
# Copy this to `.env` at the repo root and fill in the values.
# `.env` is gitignored — never commit real secrets.
#
# The docker-compose.yml reads all variables below. The API service also
# reads them at runtime via the same names.

# ---- Required ----

# Postgres connection string. We use the REMOTE Render Postgres instance
# (no Postgres container in compose). For Render the format is:
#   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# For a local Postgres the same URL without sslmode works.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# ---- Optional (defaults shown) ----

# Simulator lifecycle on `docker compose up`
SIMULATOR_START_MODE=paused          # paused | running
SIMULATION_SPEED=2
TICK_MINUTES=15

# Shared admin token for /api/admin/demo/* and approve endpoints
OPERATOR_TOKEN=local-dev-token

# Background poll interval in seconds (SSE is primary; this is the safety net)
POLL_INTERVAL_SECONDS=3

# API log level
LOG_LEVEL=INFO

# CORS origins (comma-separated). Empty = allow all.
CORS_ORIGINS=

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin