# Simulator URL: leave empty to run in mock mode
SIMULATOR_URL=

# Database
# Local Postgres:
#   DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DBNAME
# Hosted Postgres (e.g. Render) — usually requires SSL:
#   DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DBNAME

# Operator token (required for /api/admin/demo/* and approve endpoints)
OPERATOR_TOKEN=local-dev-token

# Tick polling safety-net (seconds). SSE hints drive most fetches;
# this is the backup poll in case SSE drops.
POLL_INTERVAL_SECONDS=3

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# CORS origins (comma-separated). Empty means allow all.
CORS_ORIGINS=
