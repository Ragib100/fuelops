# Tick polling safety-net (seconds). SSE hints drive most fetches;
# this is the backup poll in case SSE drops.
POLL_INTERVAL_SECONDS=3

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# CORS origins (comma-separated). Empty means allow all.
CORS_ORIGINS=
