# Simulator URL: leave empty to run in mock mode
SIMULATOR_URL=http://localhost:8000

# Database (Render Postgres)
DATABASE_URL=postgresql+psycopg://ragib:7ghjKL8DzEoSYPCGvlmvxqR8KcOnZ4rl@dpg-dauu2lojo6nc73ek9oug-a.singapore-postgres.render.com/fuelops?sslmode=require

# Operator token (required for /api/admin/demo/* and approve endpoints)
