# FuelOps frontend environment template.
# For local dev, copy this to `.env.local` and fill in. `.env.local` is gitignored.
#
# Backend base URL (NO trailing slash). The Next.js rewrite in next.config.js
# proxies /api/* → ${BACKEND_URL}/api/*, but pages can also call this directly.
BACKEND_URL=http://localhost:8080

# Shared operator token for /api/admin/demo/* endpoints. Sent as
# X-Operator-Token. The NEXT_PUBLIC_ prefix exposes it to the browser bundle,
# which is required because the demo page calls admin endpoints from the client.
# In production this should be guarded differently — for the hackathon demo the
# token is a shared dev secret, not a real auth credential.
NEXT_PUBLIC_OPERATOR_TOKEN=replace-me